# Copy to apps/web/.env.local and fill in. Every NEXT_PUBLIC_ value is shipped to the
# browser, so never put secrets here (no private keys, no indexer admin secret).

# REQUIRED. Which network this build talks to. The app never switches networks by itself.
#   local-demo     anvil + packages/contracts/script/LocalDemo.s.sol (test MockToken, not AUSD).
#                  The values below default to the local demo and can stay empty.
#   monad-testnet  a real TallyLedger deployment (none exists yet). Users sign with Mera
#                  passkey wallets (regular accounts; they pay their own MON gas).
NEXT_PUBLIC_TALLY_NETWORK=

# Optional consistency check: 31337 for local-demo, 10143 for monad-testnet.
NEXT_PUBLIC_CHAIN_ID=

# RPC endpoint. local-demo default: http://127.0.0.1:8545 (must be a local address).
# Monad testnet public RPC: https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=

# TallyLedger address. local-demo default: the deterministic LocalDemo address on a fresh anvil.
# monad-testnet: your own deployment; there is no default.
NEXT_PUBLIC_TALLY_LEDGER_ADDRESS=

# Expected settlement token. The app reads settlementToken() from the ledger and refuses token
# payments if it differs. local-demo default: the LocalDemo MockToken.
# monad-testnet default: Agora AUSD 0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
NEXT_PUBLIC_AUSD_ADDRESS=

# Envio GraphQL endpoint (HTTP; the WebSocket URL is derived). local-demo default:
# http://localhost:8080/v1/graphql. Queries use Hasura's public role; never add the admin secret.
NEXT_PUBLIC_INDEXER_GRAPHQL_URL=

# Passkey domain (WebAuthn relying-party ID). Defaults to the page's hostname. Passkeys only
# work on this domain and its subdomains, so set it to your real domain before launch: wallets
# created on localhost or preview URLs can't be used elsewhere. Not a secret.
NEXT_PUBLIC_PASSKEY_RP_ID=

# Aurora Intents API key (later step; unused now; documented as non-confidential).
NEXT_PUBLIC_AURORA_API_KEY=
