pragma solidity 0.8.37;

import {Test} from "forge-std/Test.sol";
import {TallyLedger} from "../src/TallyLedger.sol";
import {MockToken} from "./mocks/MockToken.sol";

/// @notice Replays scenarios computed by packages/core (test/fixtures/core-fixtures.json,
/// generated by packages/core/src/contract-fixtures.test.ts) and checks that the contract
/// produces the same shares and the same net balances after every operation.
contract CoreFixturesTest is Test {
    string internal json;
    /// Fresh per scenario.
    TallyLedger internal ledger;
    MockToken internal token;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/test/fixtures/core-fixtures.json"));
    }

    function test_fixtureFileHasScenarios() public view {
        assertGt(vm.parseJsonUint(json, ".scenarioCount"), 0);
    }

    function test_contractMatchesCoreFixtures() public {
        uint256 scenarioCount = vm.parseJsonUint(json, ".scenarioCount");
        for (uint256 s = 0; s < scenarioCount; ++s) {
            _replay(s);
        }
    }

    function _replay(uint256 s) internal {
        string memory scenario = string.concat(".scenarios[", vm.toString(s), "]");
        string memory name = vm.parseJsonString(json, string.concat(scenario, ".name"));
        address[] memory members =
            vm.parseJsonAddressArray(json, string.concat(scenario, ".members"));

        token = new MockToken(6);
        ledger = new TallyLedger(address(token));
        address[] memory others = new address[](members.length - 1);
        for (uint256 i = 1; i < members.length; ++i) {
            others[i - 1] = members[i];
        }
        vm.prank(members[0]);
        uint256 groupId = ledger.createGroup("Fixture", others);

        uint256 opCount = vm.parseJsonUint(json, string.concat(scenario, ".opCount"));
        for (uint256 i = 0; i < opCount; ++i) {
            string memory op = string.concat(scenario, ".ops[", vm.toString(i), "]");
            _apply(groupId, op, keccak256(abi.encode(s, i)));

            int256[] memory expected = vm.parseJsonIntArray(json, string.concat(op, ".netsAfter"));
            int256 sum = 0;
            for (uint256 m = 0; m < members.length; ++m) {
                int256 actual = ledger.netBalance(groupId, members[m]);
                assertEq(actual, expected[m], string.concat(name, ": op ", vm.toString(i), " net"));
                sum += actual;
            }
            assertEq(sum, 0, string.concat(name, ": balances must sum to zero"));
        }
    }

    function _apply(uint256 groupId, string memory op, bytes32 id) internal {
        string memory kind = vm.parseJsonString(json, string.concat(op, ".kind"));
        address actor = vm.parseJsonAddress(json, string.concat(op, ".actor"));
        uint256 amount = vm.parseJsonUint(json, string.concat(op, ".amount"));

        if (_eq(kind, "token") || _eq(kind, "acknowledged")) {
            _settle(groupId, op, id, _eq(kind, "token"));
            return;
        }

        address[] memory participants =
            vm.parseJsonAddressArray(json, string.concat(op, ".participants"));
        uint256[] memory shares = vm.parseJsonUintArray(json, string.concat(op, ".shares"));
        bool isEqual = _eq(kind, "equal");

        // The emitted shares must equal the shares packages/core computed.
        vm.expectEmit(true, true, true, true, address(ledger));
        emit TallyLedger.ExpenseRecorded(
            groupId,
            id,
            actor,
            amount,
            isEqual ? TallyLedger.SplitType.Equal : TallyLedger.SplitType.Custom,
            participants,
            shares,
            ""
        );
        vm.prank(actor);
        if (isEqual) {
            ledger.recordEqualExpense(groupId, id, amount, participants, "");
        } else {
            ledger.recordCustomExpense(groupId, id, amount, participants, shares, "");
        }
    }

    function _settle(uint256 groupId, string memory op, bytes32 id, bool withToken) internal {
        address actor = vm.parseJsonAddress(json, string.concat(op, ".actor"));
        uint256 amount = vm.parseJsonUint(json, string.concat(op, ".amount"));
        address from = vm.parseJsonAddress(json, string.concat(op, ".from"));
        address to = vm.parseJsonAddress(json, string.concat(op, ".to"));
        uint256 received = token.balanceOf(to);
        if (withToken) {
            assertEq(actor, from, "debtor pays with tokens");
            token.mint(from, amount);
            vm.prank(from);
            token.approve(address(ledger), amount);
            vm.prank(from);
            ledger.settleWithToken(groupId, id, to, amount);
            assertEq(token.balanceOf(to) - received, amount, "recipient paid in tokens");
        } else {
            assertEq(actor, to, "creditor acknowledges");
            vm.prank(to);
            ledger.acknowledgeSettlement(groupId, id, from, amount);
            assertEq(token.balanceOf(to), received, "acknowledgement moves no tokens");
        }
        assertEq(token.balanceOf(address(ledger)), 0);
    }

    function _eq(string memory a, string memory b) internal pure returns (bool) {
        return keccak256(bytes(a)) == keccak256(bytes(b));
    }
}
