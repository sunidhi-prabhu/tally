# Copy to packages/contracts/.env and fill in. Never commit .env. Foundry and the deployment
# tooling both read this file. NEVER put a private key or seed phrase here: the tooling refuses
# to run if PRIVATE_KEY, DEPLOYER_PRIVATE_KEY or MNEMONIC is set.

# --- Monad TESTNET only (chain 10143). There is no mainnet configuration in this repo. ---
# Public endpoint (rate-limited): https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=

# Signer: a Foundry keystore name (create with `cast wallet import <name> --interactive`),
# or set DEPLOYER_LEDGER=true to sign with a Ledger hardware wallet. Exactly one.
DEPLOYER_ACCOUNT=
DEPLOYER_LEDGER=
# The public address of that keystore / Ledger account (used for preflight and --sender).
DEPLOYER_ADDRESS=

# Settlement token passed to the TallyLedger constructor (immutable after deployment).
# Monad testnet Agora AUSD: 0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
#   Source: https://docs.agora.finance/developer/contract-deployments (checked 2026-10-10)
#   On-chain: symbol "AUSD", decimals 6. The deploy script rejects anything else, including
#   MAINNET AUSD (0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a).
AUSD_ADDRESS=

# Final, deliberate confirmation for `deploy:testnet:broadcast`. Leave empty until a human has
# reviewed the preflight output. Expected value: monad-testnet:10143
TALLY_CONFIRM_DEPLOY=

# Fork tests (test/fork/*) against real testnet AUSD, read-only.
RUN_FORK_TESTS=false

# Optional: Monadscan API key for `forge verify-contract --verifier etherscan`.
MONADSCAN_API_KEY=
