{
  "name": "@tally/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Tally Solidity contracts (Foundry). Requires forge >= 1.8.0 on PATH.",
  "scripts": {
    "build": "forge build --sizes",
    "test": "forge test && node --test scripts/deploy-testnet.test.mjs",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "test:fork": "RUN_FORK_TESTS=true forge test --match-path 'test/fork/*' -vv",
    "deploy:testnet:preflight": "node scripts/deploy-testnet.mjs preflight",
    "deploy:testnet:broadcast": "node scripts/deploy-testnet.mjs broadcast",
    "deploy:testnet:record": "node scripts/deploy-testnet.mjs record"
  }
}
