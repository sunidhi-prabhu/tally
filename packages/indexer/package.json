{
  "name": "@tally/indexer",
  "version": "0.0.0",
  "private": true,
  "description": "Envio HyperIndex read layer for TallyLedger. Read-only: it never sends transactions.",
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "dev:testnet": "node scripts/check-testnet.mjs && ENVIO_CONFIG=config.monad-testnet.yaml envio dev",
    "start:testnet": "node scripts/check-testnet.mjs && ENVIO_CONFIG=config.monad-testnet.yaml envio start",
    "stop": "envio stop",
    "abi:sync": "node scripts/sync-abi.mjs",
    "lint": "eslint .",
    "typecheck": "envio codegen && tsc --noEmit",
    "test": "envio codegen && vitest run",
    "test:local-chain": "RUN_LOCAL_CHAIN_TESTS=true vitest run test/local-chain.test.ts",
    "build": "node scripts/sync-abi.mjs --check && node scripts/sync-core.mjs --check",
    "testnet:check": "node scripts/check-testnet.mjs",
    "testnet:check-config": "node scripts/check-testnet.mjs --config-only",
    "core:sync": "node scripts/sync-core.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "envio": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
