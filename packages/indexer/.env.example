# Copy to packages/indexer/.env (git-ignored). Never commit real values.
# Only needed for config.monad-testnet.yaml; the default local config (anvil) needs nothing.

# Envio API token. Required to read Monad testnet through HyperSync.
# Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Your TallyLedger deployment on Monad testnet (chain 10143). Nothing has been deployed yet:
# fill these in from your own deployment's broadcast output. The indexer refuses to start
# without them; there is deliberately no default.
ENVIO_TALLY_LEDGER_ADDRESS=
# Block the contract was deployed in. Must not be later than the deployment, or the indexer
# stops with "Group N is not indexed".
ENVIO_TALLY_LEDGER_START_BLOCK=
